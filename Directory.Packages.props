<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Build / packaging">
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.301" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup Label="Source generator">
    <!--
      Deliberately pinned below the SDK's own Roslyn (5.x). A generator referencing 4.14 loads into
      any compiler >= 17.14 / SDK 9+, which keeps the analyzer package usable from older tooling.
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup Label="Entity Framework Core">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <!--
      EF Core's SQLite provider still resolves SQLitePCLRaw 2.1.11, which carries GHSA-2m69-gcr7-jv3q.
      Transitive pinning lifts it to a patched build. Test-only: no shipped package depends on SQLite.
    -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="3.0.5" />
    <PackageVersion Include="SQLitePCLRaw.provider.e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <!--
      FsCheck.Xunit targets xunit.extensibility.execution [2.4.1, 3.0.0) and is therefore xUnit v2
      only. FsCheck.Xunit.v3 is the xUnit v3 integration.
    -->
    <PackageVersion Include="FsCheck.Xunit.v3" Version="3.3.4" />
  </ItemGroup>

  <ItemGroup Label="Benchmarks">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="NodaMoney" Version="2.7.0" />
  </ItemGroup>

</Project>
