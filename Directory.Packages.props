<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Build / packaging">
    <!--
      10.0.301 brought in Microsoft.Build.Tasks.Git with GHSA-23fw-v26w-5fgq (NU1902), which the
      dependency-audit job turns into a failed build.
    -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.402" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup Label="Source generator">
    <!--
      Deliberately pinned below the SDK's own Roslyn (5.x). A generator referencing 4.14 loads into
      any compiler >= 17.14 / SDK 9+, which keeps the analyzer package usable from older tooling.
      Moving to 5.x would make Riddersholm.Money.Generators fail to load (CS9057) for every consumer
      on an older compiler, so Dependabot ignores major bumps of both packages; raise them on purpose.
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
  </ItemGroup>

  <ItemGroup Label="Entity Framework Core">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <!--
      EF Core's SQLite provider still resolves SQLitePCLRaw 2.1.11, which carries GHSA-2m69-gcr7-jv3q.
      Transitive pinning lifts it to a patched build. Test-only: no shipped package depends on SQLite.
    -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="3.0.5" />
    <PackageVersion Include="SQLitePCLRaw.provider.e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!--
      xunit.v3 4.x runs on Microsoft.Testing.Platform 2.x, the same platform version the
      Microsoft.Testing.Extensions packages target. On 3.x the two disagreed (MTP 1.x vs 2.x), so
      registering the coverage extension failed every test run with a TypeLoadException and the
      pipeline had to go without coverage.
    -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <!--
      FsCheck.Xunit targets xunit.extensibility.execution [2.4.1, 3.0.0) and is therefore xUnit v2
      only. FsCheck.Xunit.v3 is the xUnit v3 integration; 3.5 is the line built for xunit.v3 4.x.
    -->
    <PackageVersion Include="FsCheck.Xunit.v3" Version="3.5.0" />
  </ItemGroup>

  <ItemGroup Label="Benchmarks">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="NodaMoney" Version="2.8.0" />
  </ItemGroup>

</Project>
