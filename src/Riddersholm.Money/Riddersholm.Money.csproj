<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Riddersholm.Money</RootNamespace>
    <AssemblyName>Riddersholm.Money</AssemblyName>
    <PackageId>Riddersholm.Money</PackageId>
    <Description>A modern, immutable Money value object for .NET with complete ISO 4217 currency support, exact decimal arithmetic, sum-preserving allocation, allocation-free formatting and parsing, System.Text.Json support, and full trimming/NativeAOT compatibility.</Description>
  </PropertyGroup>

  <!-- No PackageReferences: System.Text.Json ships in the net10.0 shared framework. -->

  <PropertyGroup>
    <!-- Emit Currency members and the metadata table into this assembly rather than extension members. -->
    <RiddersholmMoneyEmitCore>true</RiddersholmMoneyEmitCore>
  </PropertyGroup>

  <!--
    Write the generator's output to disk for inspection:
      dotnet build src/Riddersholm.Money -p:EmitGeneratedCurrencySource=true
    Off by default so ordinary builds leave no untracked files behind.
  -->
  <PropertyGroup Condition="'$(EmitGeneratedCurrencySource)' == 'true'">
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(RepositoryRoot)generated/$(MSBuildProjectName)</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Riddersholm.Money.Generators\Riddersholm.Money.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The library dogfoods its own generator: the ISO table comes from the same path consumers use. -->
    <AdditionalFiles Include="$(RepositoryRoot)eng\iso-4217.json" RiddersholmCurrencies="true" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="RiddersholmCurrencies" />
    <CompilerVisibleProperty Include="RiddersholmMoneyEmitCore" />
    <CompilerVisibleProperty Include="RootNamespace" />
  </ItemGroup>

</Project>
