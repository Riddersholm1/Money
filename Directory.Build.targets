<Project>

  <!--
    Packable projects get the full open-source treatment: SourceLink, README, and public-API tracking.
    The properties that shape the package live in src/Directory.Build.props, because the SDK reads
    several of them while evaluating the project body.
  -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <None Include="$(RepositoryRoot)README.md" Pack="true" PackagePath="\" Visible="false" />
    <!-- Regenerate with: python3 eng/generate-icon.py -->
    <None Include="$(RepositoryRoot)assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <!--
      API tracking switches itself on for any project that has declared a baseline. A project opts in
      by adding PublicAPI.Shipped.txt; from then on every public surface change must be acknowledged
      in a diff before the build passes.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all"
                      Condition="Exists('PublicAPI.Shipped.txt')" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" Condition="Exists('PublicAPI.Shipped.txt')" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" Condition="Exists('PublicAPI.Unshipped.txt')" />
  </ItemGroup>

</Project>
